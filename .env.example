# Application
PORT=3000
NODE_ENV=development

# PostgreSQL
# Local dev (API on host): DATABASE_HOST=localhost
# Docker Compose (API in container): DATABASE_HOST=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=colombian_fruits
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Use migrations (pnpm migration:run). Keep false in all environments.
DATABASE_SYNCHRONIZE=false

# SSL — required for Neon (Render production). Keep false for local Docker.
DATABASE_SSL=false

# Frontend origin for CORS (Vite dev server). In production: https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173

# --- Production (Neon + Render) — set in Render dashboard, not in local .env ---
# DATABASE_HOST=ep-xxxx.us-west-2.aws.neon.tech
# DATABASE_NAME=neondb
# DATABASE_USER=neondb_owner
# DATABASE_PASSWORD=<neon-password>
# DATABASE_SSL=true
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend.example.com
